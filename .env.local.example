# Optional for local preview: without BOTH values the site uses repository content.
# For deployment, use the verified Goat Journey Supabase project, not GoatJourney Lab.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also supported. NEVER put a service_role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional analytics / ownership verification. Use actual tokens from your accounts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
